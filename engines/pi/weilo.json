{
  "apiVersion": 1,
  "kind": "engine",
  "name": "pi",
  "title": "Weilo's built-in AI",
  "description": "Works with an API key or a plan sign-in. Built in.",
  "install": { "npm": ["pi-acp@0.0.34", "@earendil-works/pi-coding-agent@1.4.0"] },
  "command": ["{install}/node_modules/.bin/pi-acp"],
  "env": { "PATH": "{install}/node_modules/.bin:{PATH}" },
  "gateway": { "env": { "PI_CODING_AGENT_DIR": "{engine_home}" } },
  "detect": { "always": true },
  "default": true,
  "bindsApprovals": true
}
