{
  "apiVersion": 1,
  "kind": "engine",
  "name": "claude-code",
  "title": "Claude Code",
  "description": "Anthropic's coding agent, with your own sign-in.",
  "install": { "npm": ["@zed-industries/claude-agent-acp@0.23.1"] },
  "command": ["{install}/node_modules/.bin/claude-agent-acp"],
  "launch": {
    "deny": ["--dangerously-skip-permissions"],
    "env": { "CLAUDE_CODE_DISABLE_BYPASS": "1", "DISABLE_AUTOUPDATER": "1" }
  },
  "passEnv": ["ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN"],
  "keys": [{ "id": "anthropic", "title": "Anthropic", "env": "ANTHROPIC_API_KEY" }],
  "signIn": {
    "files": ["~/.claude/.credentials.json"],
    "keychain": ["Claude Code-credentials"],
    "how": "Open Terminal, run `claude` and sign in.",
    "command": "claude",
    "get": "Install it from Terminal: npm install -g @anthropic-ai/claude-code."
  },
  "model": { "env": { "ANTHROPIC_MODEL": "{model}", "ANTHROPIC_SMALL_FAST_MODEL": "{model}" } },
  "detect": { "commands": ["claude"], "paths": ["~/.claude"] },
  "bindsApprovals": true
}
