{
  "apiVersion": 1,
  "kind": "engine",
  "name": "claude-code",
  "title": "Claude Code",
  "description": "Anthropic's coding agent, with your own sign-in.",
  "install": { "npm": ["@zed-industries/claude-agent-acp@0.23.1"] },
  "command": ["{install}/node_modules/.bin/claude-agent-acp"],
  "launch": { "deny": ["--dangerously-skip-permissions"] },
  "env": { "CLAUDE_CONFIG_DIR": "{engine_home}" },
  "model": { "env": { "ANTHROPIC_MODEL": "{model}", "ANTHROPIC_SMALL_FAST_MODEL": "{model}" } },
  "detect": { "commands": ["claude"], "paths": ["~/.claude"] },
  "bindsApprovals": true
}
